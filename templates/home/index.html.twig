{% extends 'base.html.twig' %}

{% block title %}Поиск товаров{% endblock %}

{% block stylesheets %}
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f6f8;
            margin: 0;
            padding: 0;
            color: #222;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .search-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 40vh;
            gap: 16px;
        }

        .search-form {
            display: flex;
            gap: 8px;
            width: 100%;
            max-width: 480px;
        }

        .search-input {
            flex: 1;
            padding: 12px 16px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 8px;
            outline: none;
            transition: border-color .2s;
        }

        .search-input:focus {
            border-color: #4a90e2;
        }

        .search-button {
            padding: 12px 24px;
            font-size: 16px;
            background: #4a90e2;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background .2s;
        }

        .search-button:hover {
            background: #357abd;
        }

        .products {
            margin-top: 40px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .product-card {
            background: #fff;
            border-radius: 10px;
            padding: 16px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .product-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
            background: #eee;
        }

        .product-title {
            font-size: 17px;
            font-weight: 600;
            margin: 0;
        }

        .product-description {
            font-size: 14px;
            color: #666;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-price {
            font-size: 18px;
            color: #2c7a2c;
            font-weight: 700;
            margin-top: auto;
        }

        .empty {
            text-align: center;
            color: #888;
            margin-top: 40px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">

        <div class="search-center">
            <form class="search-form" method="get" action="{{ path('app_home') }}">
                <input
                    type="text"
                    name="q"
                    class="search-input"
                    placeholder="Введите название товара..."
                    value="{{ q }}"
                >
                <button type="submit" class="search-button">Поиск</button>
            </form>
        </div>

        {% if products is empty %}
            <p class="empty">Товары не найдены.</p>
        {% else %}
            <div class="products">
                {% for product in products %}
                    <div class="product-card">
                        {% if product.image %}
                            <img
                                class="product-image"
                                src="{{ product.image }}"
                                alt="{{ product.title }}"
                                onerror="this.src='https://via.placeholder.com/300x180?text=No+Image'"
                            >
                        {% else %}
                            <img
                                class="product-image"
                                src="https://via.placeholder.com/300x180?text=No+Image"
                                alt="Нет изображения"
                            >
                        {% endif %}

                        <h3 class="product-title">{{ product.title }}</h3>

                        {% if product.description %}
                            <p class="product-description">{{ product.description }}</p>
                        {% endif %}

                        <div class="product-price">{{ product.price|number_format(0, ',', ' ') }} ₽</div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
